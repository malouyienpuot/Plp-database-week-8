// Paste this file into https://dbdiagram.io to render the ER diagram.
// Reserved by Malou Yien.

Table tenants {
  id bigint [pk, increment]
  name varchar(160) [not null]
  created_at timestamptz [not null]
}

Table app_users {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  full_name varchar(160) [not null]
  email varchar(254) [not null]
  role varchar(20) [not null, note: 'admin, trainer, student']
  created_at timestamptz [not null]

  indexes {
    (tenant_id, email) [unique]
    (tenant_id, role)
  }
}

Table courses {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  title varchar(180) [not null]
  description text
  is_active boolean [not null]
  created_at timestamptz [not null]

  indexes {
    (tenant_id, title)
  }
}

Table enrollments {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  student_id bigint [not null, ref: > app_users.id]
  course_id bigint [not null, ref: > courses.id]
  enrolled_at timestamptz [not null]
  status varchar(20) [not null, note: 'enrolled, completed, withdrawn']

  indexes {
    (tenant_id, student_id, course_id) [unique]
    (tenant_id, course_id, status)
  }
}

Table attendance {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  enrollment_id bigint [not null, ref: > enrollments.id]
  class_date date [not null]
  status varchar(20) [not null, note: 'present, absent, late, excused']
  recorded_at timestamptz [not null]

  indexes {
    (tenant_id, enrollment_id, class_date) [unique]
    (tenant_id, class_date, status)
  }
}

Table audit_logs {
  id bigint [pk, increment]
  tenant_id bigint
  table_name text [not null]
  operation text [not null]
  row_id text
  changed_at timestamptz [not null]
  db_user text [not null]
  old_data jsonb
  new_data jsonb
}
